# Server only. Put your DeepSeek key here (the name is required by the adapter).
# Never use an EXPO_PUBLIC_ prefix for credentials.
OPENAI_API_KEY=replace-with-your-server-key
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
# For OpenAI instead: OPENAI_BASE_URL=https://api.openai.com/v1 and an OpenAI model/key.
PORT=8787

# Client public configuration: for a physical device, use the computer's LAN IP.
# Simulator defaults: iOS 127.0.0.1:8787; Android emulator 10.0.2.2:8787.
# EXPO_PUBLIC_TANSTACK_AI_BASE_URL=http://192.168.1.10:8787
